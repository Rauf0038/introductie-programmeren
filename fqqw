
def travel_costs(km: int) -> float:

    >>> travel_costs(1250)
    325.0
    >>> travel_costs(800)
    208.0
    """
    return km * 2 * 0.13


def overnight_costs(nights: int) -> float:
    """
    Bepaalt de verblijfskosten.

    >>> overnight_costs(5)
    300
    >>> overnight_costs(10)
    600
    """
    return nights * 60


def total_costs(km: int, nights: int) -> int:
    """
    Bepaalt de totale vakantiekosten en rondt af op hele euro's.

    >>> total_costs(1250, 5)
    625
    >>> total_costs(800, 10)
    808
    >>> total_costs(2159, 12)
    1281
    """
    total = travel_costs(km) + overnight_costs(nights)
    return int(total + 0.5)


if __name__ == '__main__':
    km = int(input("Hoe ver ga je weg in kilometers? "))
    nights = int(input("Hoe veel nachten is je verblijf? "))

    costs = total_costs(km, nights)

    print(f"Jouw vakantie kost: {costs}")
